{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vivla-wiki",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "c38baece52cddd64baab323c3550ce17",
  // No default domain of any kind: no *.workers.dev, no preview URLs. The
  // only way in is the Worker route / custom domain added at deploy time
  // (see the runbook) behind Cloudflare Access. Defense in depth: even if
  // one of these were ever flipped back on by mistake, src/access.ts still
  // 403s every request without a valid Access JWT.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    // Placeholder during development (this worktree does not build the
    // Starlight site — see site/ on feat/starlight-site). Point this at
    // ../site/dist once that lands and the two branches are merged.
    "directory": "./public-placeholder",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "FEEDBACK",
      "database_name": "vivla-wiki-feedback",
      "migrations_dir": "migrations",
      // Not created in the account yet — see the deploy runbook in
      // worker/README.md. Replace with the real id from `wrangler d1 create`.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://vivla.cloudflareaccess.com",
    // AUD of the Access app "VIVLA Docs" (wiki.vivla.com). Comma-separated;
    // append the AUD of the future "wiki-next" staging app/destination here
    // once it exists — no code change needed, see worker/README.md.
    "ACCESS_AUD": "dc70ab4583ee9538450fcb3a48ca18efe08e1a392f7f7eb94dafec9310fdff36",
    "SITE_BASE_URL": "https://wiki.vivla.com"
  },
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "vars": {
        "ACCESS_TEAM_DOMAIN": "https://vivla.cloudflareaccess.com",
        "ACCESS_AUD": "dc70ab4583ee9538450fcb3a48ca18efe08e1a392f7f7eb94dafec9310fdff36",
        "SITE_BASE_URL": "https://wiki-next.vivla.com"
      },
      "routes": [{ "pattern": "wiki-next.vivla.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "FEEDBACK",
          "database_name": "vivla-wiki-feedback-staging",
          "migrations_dir": "migrations",
          "database_id": "00000000-0000-0000-0000-000000000000"
        }
      ]
    }
  }
}
