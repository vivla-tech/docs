{
  // Test-only: identical to wrangler.jsonc minus the `ai` binding and the
  // `staging` env. Miniflare's local worker crashes outright ("Worker
  // exited unexpectedly") when a Worker declares an `ai` binding and no
  // real Cloudflare auth is available to proxy it — not just a catchable
  // error, so there's no way to keep it declared and work around it from
  // test code. Real Workers AI calls for this project run from the Mac's
  // authenticated `cf` profile (scripts/build-embeddings.mjs,
  // scripts/evaluate-search.mjs); search.test.ts mocks env.AI.run()
  // directly to exercise the hybrid code path. Keep this file's non-`ai`
  // settings in sync with wrangler.jsonc by hand — there are few enough of
  // them that a generator would be more code than it saves.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vivla-wiki",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "c38baece52cddd64baab323c3550ce17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public-placeholder",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "FEEDBACK",
      "database_name": "vivla-wiki-feedback",
      "migrations_dir": "migrations",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://vivla.cloudflareaccess.com",
    "ACCESS_AUD": "dc70ab4583ee9538450fcb3a48ca18efe08e1a392f7f7eb94dafec9310fdff36",
    "SITE_BASE_URL": "https://wiki.vivla.com"
  },
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true }
}
