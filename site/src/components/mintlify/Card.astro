---
// Mintlify <Card title icon href>. Starlight's own <Card> uses its own
// (small) icon set, not Font Awesome, and has no href, so this is a custom
// component rather than a wrapper.
import { Icon } from 'astro-icon/components';
import { resolveIcon } from '../../lib/icon-map';

interface Props {
  title: string;
  icon?: string;
  href?: string;
}

const { title, icon, href } = Astro.props as Props;
const iconName = resolveIcon(icon);
const isExternal = href ? /^https?:\/\//.test(href) : false;
const Tag = href ? 'a' : 'div';
const linkAttrs = href
  ? { href, ...(isExternal ? { target: '_blank', rel: 'noreferrer' } : {}) }
  : {};
---

<Tag class="mintlify-card not-content" {...linkAttrs}>
  {iconName && <Icon name={iconName} class="mintlify-card-icon" />}
  <p class="mintlify-card-title">{title}</p>
  <div class="mintlify-card-body"><slot /></div>
</Tag>

<style>
  .mintlify-card {
    display: block;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background-color: var(--sl-color-bg);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  a.mintlify-card:hover,
  a.mintlify-card:focus-visible {
    border-color: var(--sl-color-text-accent);
  }
  .mintlify-card-icon {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    margin-bottom: 0.65rem;
    color: var(--sl-color-text-accent);
  }
  .mintlify-card-title {
    margin: 0 0 0.35rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .mintlify-card-body {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .mintlify-card-body :global(> *:first-child) {
    margin-top: 0;
  }
  .mintlify-card-body :global(> *:last-child) {
    margin-bottom: 0;
  }
</style>
