---
// Mintlify <CardGroup cols>. Starlight's <CardGrid> has no `cols` prop
// (it's always 2 at most widths), so this is a small custom grid instead.
interface Props {
  cols?: number;
}

const { cols = 2 } = Astro.props as Props;
---

<div class="mintlify-card-grid not-content" style={`--mintlify-cols: ${cols}`}>
  <slot />
</div>

<style>
  .mintlify-card-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
    margin: 1rem 0;
  }
  @media (min-width: 50rem) {
    .mintlify-card-grid {
      grid-template-columns: repeat(var(--mintlify-cols, 2), 1fr);
    }
  }
</style>
